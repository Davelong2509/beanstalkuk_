# Public website URL used for metadata and sitemap generation
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Add email, form delivery, analytics and Sanity credentials when those integrations are implemented.


# Visit request delivery (Resend)
# Create an API key and verify the sender domain in your Resend account.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Defaults to the nursery email shown on the website if left blank.
VISIT_NOTIFICATION_EMAIL=asha.patel@beanstalkdaynursery.co.uk

# Admissions enquiry and registration-interest notifications
ENQUIRY_NOTIFICATION_EMAIL=asha.patel@beanstalkdaynursery.co.uk
